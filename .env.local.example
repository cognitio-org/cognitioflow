# Local development — copy to .env.local. Never commit .env.local.
ANTHROPIC_API_KEY=sk-ant-...

# Phase 1: database
DATABASE_URL=postgresql://cf:cf@localhost:5432/cognitioflow
# Neon (prod / branches) looks like:
# DATABASE_URL=postgresql://user:pass@ep-xxxx-pooler.eu-central-1.aws.neon.tech/cognitioflow?sslmode=require

# One-shot SQLite migration (migrate_sqlite.py)
MATEJ_EMAIL=you@example.com

# Phase 2: storage — local | gcs   (cloud uses gcs; credentials via ADC, never a key file)
STORAGE=local
STORAGE_LOCAL_ROOT=./data
# GCS_BUCKET=cognitioflow-user-content
# GCP_PROJECT=vigilant-axis-483119-r8
# STORAGE_EMULATOR_HOST=http://localhost:4443   # only with docker compose --profile gcs
# Signed URLs against the real bucket need a service-account identity locally:
#   gcloud auth application-default login --impersonate-service-account cognitioflow-run@vigilant-axis-483119-r8.iam.gserviceaccount.com

# Phase 3: transcription — Google Speech-to-Text v2 batch (needs STORAGE=gcs and ADC)
STT=hosted
STT_PROVIDER=google
STT_REGION=europe-west4
# Until Phase 3 lands, the old local Whisper path still works:
CF_WHISPER=small

# Models (unchanged)
CF_MODEL=claude-sonnet-4-6
CF_CHEAP_MODEL=claude-haiku-4-5
CF_STRONG_MODEL=claude-sonnet-4-6
CF_CONTEXT_CHARS=180000
# CF_LOG_LEVEL=DEBUG   # logs each tutor system prompt (course brief included); never the API key
