# Local development — copy to .env.local. Never commit .env.local.
ANTHROPIC_API_KEY=sk-ant-...

# Phase 1: database
DATABASE_URL=postgresql://cf:cf@localhost:5432/cognitioflow
# Neon (prod / branches) looks like:
# DATABASE_URL=postgresql://user:pass@ep-xxxx-pooler.eu-central-1.aws.neon.tech/cognitioflow?sslmode=require

# One-shot SQLite migration (migrate_sqlite.py)
MATEJ_EMAIL=you@example.com

# Phase 2: storage — local | gcs   (cloud uses gcs; credentials via ADC, never a key file)
STORAGE=local
STORAGE_LOCAL_ROOT=./data
# GCS_BUCKET=cognitioflow-user-content
# GCP_PROJECT=vigilant-axis-483119-r8
# STORAGE_EMULATOR_HOST=http://localhost:4443   # only with docker compose --profile gcs
# Signed URLs against the real bucket need a service-account identity locally:
#   gcloud auth application-default login --impersonate-service-account cognitioflow-run@vigilant-axis-483119-r8.iam.gserviceaccount.com

# Phase 3: transcription — Google Speech-to-Text v2 batch (needs STORAGE=gcs and ADC)
STT=hosted
STT_PROVIDER=google
STT_REGION=europe-west4
# Transcription also needs STORAGE=gcs, GCS_BUCKET and GCP_PROJECT (the recogniser reads audio straight from the bucket).

# Phase 4: sign-in. Cloud sets ENV=production and mounts SESSION_SECRET, GOOGLE_CLIENT_ID,
# GOOGLE_CLIENT_SECRET (plus ANTHROPIC_API_KEY, DATABASE_URL) from Secret Manager as env vars.
# ENV=production refuses to boot with AUTH=off or any missing secret. Check with: python3 scripts/check_env.py
# ENV=production
# AUTH=off signs you in as the first ALLOWED_EMAILS address without Google (docker dev + tests). Remove it to test real sign-in.
AUTH=off
ALLOWED_EMAILS=you@example.com
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# OAuth client (GCP console → APIs & Services → Credentials → Web application),
# redirect URI http://localhost:8000/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Models (unchanged)
CF_MODEL=claude-sonnet-4-6
CF_CHEAP_MODEL=claude-haiku-4-5
CF_STRONG_MODEL=claude-sonnet-4-6
CF_CONTEXT_CHARS=180000
# CF_LOG_LEVEL=DEBUG   # logs each tutor system prompt (course brief included); never the API key

# Phase 11c/12: the speaking voice — browser | edge | google | elevenlabs | kokoro.
# Anything unconfigured falls back to the browser's own voice (free, robotic), never to silence.
TTS=browser
TTS_LANGUAGE=en-GB
# edge: Microsoft Edge's neural voices — free, no key, natural, good with legal terms; works on Cloud Run.
# Each spoken line is sent to Microsoft's (unofficial) read-aloud service.   (edge-tts is in requirements.txt)
# TTS=edge
# EDGE_VOICE=en-GB-SoniaNeural   # also en-GB-RyanNeural, en-GB-LibbyNeural, en-GB-MaisieNeural, en-GB-ThomasNeural
# EDGE_RATE=+0%
# google: Chirp 3 HD through ADC, no key.   pip install google-cloud-texttospeech
# TTS_VOICE=en-GB-Chirp3-HD-Charon
# elevenlabs: paid per character.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_flash_v2_5
# kokoro: free and offline, but LOCAL ONLY — the model is ~350MB and needs ~700MB of memory, so it is
# never installed in the Cloud Run image. Use absolute paths.
#   pip install kokoro-onnx soundfile
#   mkdir -p ~/.cache/kokoro && cd ~/.cache/kokoro && curl -L \
#     -O https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.0/kokoro-v1.0.onnx \
#     -O https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.0/voices-v1.0.bin
# TTS=kokoro
# KOKORO_MODEL_PATH=/Users/you/.cache/kokoro/kokoro-v1.0.onnx
# KOKORO_VOICES_PATH=/Users/you/.cache/kokoro/voices-v1.0.bin
# KOKORO_VOICE=bf_alice          # British: bf_alice bf_emma bf_isabella bf_lily bm_daniel bm_fable bm_george bm_lewis
