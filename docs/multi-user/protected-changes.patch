diff --git a/migrations/036_streak_freezes_per_user.sql b/migrations/036_streak_freezes_per_user.sql
new file mode 100644
index 0000000..de5c154
--- /dev/null
+++ b/migrations/036_streak_freezes_per_user.sql
@@ -0,0 +1,8 @@
+-- Streak-freeze ledger per user (ships WITH the run.py write that fills streak_freezes.user_id; see
+-- docs/multi-user/protected-changes.patch). The streak number itself was always derived from the caller's own reviews;
+-- this only stops one user's forgiven day being recorded against the course for everyone.
+-- Re-runnable. Existing rows (if any) are attributed to the course owner.
+UPDATE streak_freezes f SET user_id = c.user_id FROM courses c WHERE c.id = f.course_id AND f.user_id IS NULL;
+ALTER TABLE streak_freezes DROP CONSTRAINT IF EXISTS streak_freezes_pkey;
+CREATE UNIQUE INDEX IF NOT EXISTS streak_freezes_course_user_day ON streak_freezes(course_id, user_id, day) NULLS NOT DISTINCT;
+CREATE INDEX IF NOT EXISTS idx_streak_freezes_user ON streak_freezes(user_id);
