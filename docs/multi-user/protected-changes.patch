diff --git a/migrations/035_multiuser_ready.sql b/migrations/035_multiuser_ready.sql
new file mode 100644
index 0000000..f84cc8f
--- /dev/null
+++ b/migrations/035_multiuser_ready.sql
@@ -0,0 +1,34 @@
+-- Multi-user readiness: invites, per-user privacy settings, per-user cost lookups.
+--
+-- PURELY ADDITIVE and behaviour-neutral on its own: new tables, one nullable column, indexes. Nothing in run.py or
+-- auth.py reads these until docs/multi-user/protected-changes.patch is applied (Matej's named yes). Migrations run at
+-- app start, so this file reaches production when the PR deploys - which is why it changes no existing behaviour.
+-- SAFE TO RE-RUN: every statement is IF [NOT] EXISTS or guarded.
+
+-- 1) INVITES - the owner records an address; auth admits it (once the auth.py patch lands) in addition to
+--    ALLOWED_EMAILS. Nothing is ever sent from here: the owner shares the link himself.
+CREATE TABLE IF NOT EXISTS invites(
+    email      TEXT PRIMARY KEY,                                   -- lower-cased by the app
+    invited_by TEXT REFERENCES users(id) ON DELETE SET NULL,
+    note       TEXT NOT NULL DEFAULT '',
+    created    DOUBLE PRECISION NOT NULL,
+    revoked    DOUBLE PRECISION,                                   -- set = no longer admitted
+    accepted   DOUBLE PRECISION                                    -- first sign-in after the invite
+);
+
+-- 2) PER-USER PRIVACY SETTINGS - consent for the de-identified training capture (Art. 6(1)(a) / Art. 25 default off for
+--    everyone but the owner) and when the privacy notice was acknowledged.
+CREATE TABLE IF NOT EXISTS user_prefs(
+    user_id         TEXT PRIMARY KEY REFERENCES users(id) ON DELETE CASCADE,
+    capture_consent INTEGER,                                       -- NULL never asked, 0 no, 1 yes
+    privacy_ack     DOUBLE PRECISION,
+    updated         DOUBLE PRECISION
+);
+
+-- 3) PER-USER COST CAPS read ai_calls by (user_id, at); ai_calls.user_id already exists (024) and _log_call fills it.
+CREATE INDEX IF NOT EXISTS ai_calls_user_at ON ai_calls(user_id, at);
+
+-- 4) STREAK-FREEZE LEDGER attribution. The streak itself is derived from the caller's own reviews (no cross-user
+--    effect); only this write-only ledger is keyed by course. Add the column now (nullable, unused); the key change
+--    and the write that fills it ship together in the protected patch (036 there), so nothing half-lands.
+ALTER TABLE streak_freezes ADD COLUMN IF NOT EXISTS user_id TEXT REFERENCES users(id) ON DELETE CASCADE;
diff --git a/migrations/036_streak_freezes_per_user.sql b/migrations/036_streak_freezes_per_user.sql
new file mode 100644
index 0000000..de5c154
--- /dev/null
+++ b/migrations/036_streak_freezes_per_user.sql
@@ -0,0 +1,8 @@
+-- Streak-freeze ledger per user (ships WITH the run.py write that fills streak_freezes.user_id; see
+-- docs/multi-user/protected-changes.patch). The streak number itself was always derived from the caller's own reviews;
+-- this only stops one user's forgiven day being recorded against the course for everyone.
+-- Re-runnable. Existing rows (if any) are attributed to the course owner.
+UPDATE streak_freezes f SET user_id = c.user_id FROM courses c WHERE c.id = f.course_id AND f.user_id IS NULL;
+ALTER TABLE streak_freezes DROP CONSTRAINT IF EXISTS streak_freezes_pkey;
+CREATE UNIQUE INDEX IF NOT EXISTS streak_freezes_course_user_day ON streak_freezes(course_id, user_id, day) NULLS NOT DISTINCT;
+CREATE INDEX IF NOT EXISTS idx_streak_freezes_user ON streak_freezes(user_id);
diff --git a/migrations/037_private_progress_cards.sql b/migrations/037_private_progress_cards.sql
new file mode 100644
index 0000000..62275f8
--- /dev/null
+++ b/migrations/037_private_progress_cards.sql
@@ -0,0 +1,25 @@
+-- Multi-user: private practice cards, training-capture attribution, per-user case rotation.
+-- Ships WITH the run.py code that writes and filters these columns (docs/multi-user/protected-changes.patch), like 036.
+-- PURELY ADDITIVE: nullable columns, one new table, indexes. Old code ignores all of it. Re-runnable.
+
+-- 1) A card a user's own practice made (a missed case MCQ, a missed bench question) is PRIVATE to that user:
+--    cards.user_id set = only that user sees it, reviews it, or finds it in search/quiz/counts. NULL = shared course
+--    content, exactly as before (every card that exists today stays NULL). Erasing the user deletes their private cards.
+ALTER TABLE cards ADD COLUMN IF NOT EXISTS user_id TEXT REFERENCES users(id) ON DELETE CASCADE;
+CREATE INDEX IF NOT EXISTS idx_cards_user ON cards(user_id) WHERE user_id IS NOT NULL;
+
+-- 2) Training capture (026/027) gets an owner, so account deletion (Art. 17) and export (Art. 15) reach it. Existing
+--    rows were all made by the single user of the app; they stay NULL (no guess is written into them).
+ALTER TABLE card_gen_samples ADD COLUMN IF NOT EXISTS user_id TEXT;
+ALTER TABLE card_edits ADD COLUMN IF NOT EXISTS user_id TEXT;
+CREATE INDEX IF NOT EXISTS idx_card_gen_samples_user ON card_gen_samples(user_id) WHERE user_id IS NOT NULL;
+CREATE INDEX IF NOT EXISTS idx_card_edits_user ON card_edits(user_id) WHERE user_id IS NOT NULL;
+
+-- 3) Which banked case a user saw last, per user (case_hypos.seen was per course, so one student's practice changed
+--    what the next student was shown).
+CREATE TABLE IF NOT EXISTS case_seen(
+    user_id TEXT NOT NULL REFERENCES users(id) ON DELETE CASCADE,
+    case_id TEXT NOT NULL REFERENCES case_hypos(id) ON DELETE CASCADE,
+    seen    DOUBLE PRECISION NOT NULL,
+    PRIMARY KEY (user_id, case_id)
+);
