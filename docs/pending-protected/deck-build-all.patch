+def _deck_pool(fn, items, deadline):
+    """Run fn(item) over items on a small pool, each in the caller's request context (the owner check and the
+    per-user schedule read it). Items not started before the deadline come back as ('left', item, None)."""
+    from concurrent.futures import ThreadPoolExecutor
+    def one(pair):
+        ctx, item = pair
+        if time.monotonic() > deadline: return ("left", item, None)
+        try: return ("ok", item, ctx.run(fn, item))
+        except HTTPException as e: return ("err", item, str(e.detail))
+        except Exception as e: return ("err", item, f"{type(e).__name__}: {str(e)[:80]}")
+    pairs = [(contextvars.copy_context(), item) for item in items]   # copied HERE, in the request's thread: a worker's own context is empty
+    with ThreadPoolExecutor(max_workers=max(1, DECK_WORKERS)) as pool:
+        return list(pool.map(one, pairs))
+
