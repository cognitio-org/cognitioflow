+DECK_BUDGET_S = float(os.environ.get("CF_DECK_BUDGET_S", "100"))   # one click stops starting new model calls after this
+DECK_WORKERS = int(os.environ.get("CF_DECK_WORKERS", "6"))         # model calls in flight at once
+DECK_FILE_MAX = 200000       # a source longer than this is a codified Treaty, not one authority: not read, and said so
