+# Model answers to a past or practice exam, and answer keys: uploaded unticked, so the tutor doesn't read the answers
+# before he has tried the paper. Same rule as isAnswerFile() in static/app.js (tests/test_source_badges_w3.py keeps them
+# in step). Not included: worked WG answers, even to an exam (the course ranks them first, so they stay ticked), guidance
+# on answering ("how to answer ..."), and a name that only says "answers" ("Questions and answers on ...").
+_MODEL_ANSWER = re.compile(r"(?i)(^|[^a-z])(model[\s-]*answers?|answers?[\s-]*(key|sheet)s?|antwoordmodel|modelantwoord(en)?)([^a-z]|$)")
+_EXAM_NAME = re.compile(r"(?i)(^|[^a-z])(practice[\s-]*exam|past[\s-]*(exam|paper)|mock[\s-]*exam|resit|tentamen|exam[\s-]*\d)")
+_ANSWER_WORD = re.compile(r"(?i)(^|[^a-z])(answers|solutions|uitwerkingen?|antwoorden)([^a-z]|$)")
+_NOT_ANSWER = re.compile(r"(?i)(^|[^a-z])(wg\s*\d*|working[\s-]*groups?|werkgroep(en)?|how[\s-]+to|guidance|guide|tips|technique)([^a-z]|$)")
+_ABOUT_ANSWERS = re.compile(r"(?i)(^|[^a-z])(model[\s-]*answers?|answers?[\s-]*(key|sheet)s?)[\s-]+(guidance|guide|tips|technique|writing)([^a-z]|$)")
+
+def is_answer_file(name: str) -> bool:
+    # An explicit "model answers" / "answer key" beats the WG/guide/tips veto unless the next words make the file
+    # guidance ABOUT model answers; the veto only guards the weaker exam + "answers" match.
+    s = re.sub(r"_+", " ", name or "")
+    if _MODEL_ANSWER.search(s) and not _ABOUT_ANSWERS.search(s):
+        return True
+    if _NOT_ANSWER.search(s):
+        return False
+    return bool(_EXAM_NAME.search(s) and _ANSWER_WORD.search(s))
+
