--- /dev/null
+++ b/tests/test_case_index_years.py
@@ -0,0 +1,42 @@
+"""The Progress screen's case index (run.py) reads a judgment year the notes write and never reads one off an
+Opinion's, an ECtHR or another court's number (printpack follow-up, wave 3; ships with the run.py patch)."""
+import run
+
+
+def test_written_years_are_read_and_pages_are_not():
+    assert run._year_in("15 July 1964") == 1964 and run._year_in("Costa, 1964") == 1964
+    assert run._year_in("C-6/90, 19 November 1991") == 1991 and run._year_in("26/62, judgment 1963") == 1963
+    assert run._year_in("Case 6/64, ECR 1585") == 1964            # 1585 is a page; the number's year
+    assert run._year_in("[1963] ECR 1") == 1963 and run._year_in("ECLI:EU:C:2008:461") == 2008
+    assert run._year_in("1991", docket=False) == 1991            # a Year column
+
+
+def test_numbers_that_are_not_cjeu_dockets_give_no_year():
+    for t in ("Opinion 2/13", "5856/72", "2 BvE 2/08", "2 BvR 197/83", "2 BvR 859/15", "IX ZR 123/04"):
+        assert run._year_in(t) is None, t
+    assert run._year_in("C-6/90") == 1990 and run._year_in("Case 26/62") == 1962
+
+
+def test_the_prose_reader_keeps_the_whole_number_and_the_appeal_suffix():
+    assert run._CITE.search(" (2 BvE 2/08) on identity").group(0) == "2 BvE 2/08"
+    assert run._CITE.search(" (C-402/05 P) on review").group(0) == "C-402/05 P"
+
+
+def test_the_case_index_keeps_judgment_years_from_the_notes(client, pg):
+    cid = client.post("/api/courses", json={"name": "Index Years"}).json()["id"]
+    client.post(f"/api/courses/{cid}/notes", json={"title": "Week 1", "body":
+        "| Case | Citation |\n|---|---|\n| Francovich | C-6/90, 19 November 1991 |\n| Solange II | 2 BvR 197/83 |\n\n"
+        "*Lisbon* (2 BvE 2/08). *Brasserie* (C-46/93, judgment of 5 March 1996)."})
+    got = {c["name"]: (c["cite"], c["year"]) for c in client.get(f"/api/courses/{cid}/cases").json()}
+    assert got["Francovich"][1] == 1991 and got["Solange II"][1] is None
+    assert got["Lisbon"] == ("2 BvE 2/08", None) and got["Brasserie"][1] == 1996
+
+
+def test_a_year_is_never_borrowed_from_the_next_case_in_the_sentence(client, pg):
+    cid = client.post("/api/courses", json={"name": "Index Borrow"}).json()["id"]
+    client.post(f"/api/courses/{cid}/notes", json={"title": "Week 1", "body":
+        "*Van Gend en Loos*, Case 26/62, and *Costa v ENEL*, Case 6/64, on the new legal order. "
+        "*Dassonville* 8/74 and *Cassis de Dijon* 120/78 (1979) on goods."})
+    got = {c["name"]: c["year"] for c in client.get(f"/api/courses/{cid}/cases").json()}
+    assert got["Van Gend en Loos"] == 1962 and got["Costa v ENEL"] == 1964
+    assert got["Dassonville"] == 1974 and got["Cassis de Dijon"] == 1979
