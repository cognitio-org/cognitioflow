# Keep secrets, user data and dev-only files out of the build context.
.git
.github
.env
.env.*
data/
.venv/
tests/
docs/
infra/
__pycache__/
**/__pycache__/
*.pyc
*.db
.DS_Store
Start CognitioFlow.command
# Arena 3D player: Blender sources, renders and dev fixtures never ship
play/**/_src/
play/**/*.blend
play/**/*.blend1
play/**/*.md
play/**/fixtures/
play/**/screenshots/
