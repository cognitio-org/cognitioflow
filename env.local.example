# Local development — copy to .env.local. Never commit .env.local.
ANTHROPIC_API_KEY=sk-ant-...

# Phase 1: database
DATABASE_URL=postgresql://cf:cf@localhost:5432/cognitioflow
# Neon (prod / branches) looks like:
# DATABASE_URL=postgresql://user:pass@ep-xxxx-pooler.eu-central-1.aws.neon.tech/cognitioflow?sslmode=require

# One-shot SQLite migration (migrate_sqlite.py)
MATEJ_EMAIL=you@example.com

# Phase 2: storage — local | gcs
STORAGE=local
STORAGE_LOCAL_ROOT=./data
# GCS_BUCKET=cognitioflow-files
# STORAGE_EMULATOR_HOST=http://localhost:4443   # only with docker compose --profile gcs

# Phase 3: transcription — hosted | whisper-local
STT=whisper-local
CF_WHISPER=small

# Models (unchanged)
CF_MODEL=claude-sonnet-4-6
CF_CHEAP_MODEL=claude-haiku-4-5
CF_STRONG_MODEL=claude-sonnet-4-6
CF_CONTEXT_CHARS=180000
